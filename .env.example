# =============================================================================
# AgroFlow (farmorfx) — Environment Variables
#
# Copy this file to `.env.local` and fill in your own values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored; never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL — e.g. Neon, Supabase, local Postgres)
# -----------------------------------------------------------------------------

# Connection string used by the app at runtime (Prisma + `pg` pool).
# Required. Use a pooled connection when available.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Direct (non-pooled) connection used by the Prisma CLI for migrations and
# seeding (see prisma.config.ts). Optional — falls back to DATABASE_URL.
# Set this when DATABASE_URL goes through a pooler/pgbouncer (e.g. Neon),
# because migrations must run over a direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (NextAuth v5)
# -----------------------------------------------------------------------------

# Secret used to sign the JWT session tokens. Required in production
# (NextAuth throws if missing). Generate a strong value with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-random-32-byte-secret"
# v5 alias: AUTH_SECRET (either name works; NEXTAUTH_SECRET kept for compat).

# Public base URL of the application. Used by NextAuth for redirects/callbacks.
#   Local:     http://localhost:3000
#   Production: https://farmorfx.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# v5 alias: AUTH_URL

# -----------------------------------------------------------------------------
# Google Gemini AI (chat assistant + place summaries)
# -----------------------------------------------------------------------------

# Google Generative AI API key. Get one at:
#   https://aistudio.google.com/app/apikey
# Optional — when unset, the chat endpoint returns a fallback message instead
# of failing. Required only for full AI chat / summary features.
GEMINI_API_KEY=""

# Gemini model to use. Optional — defaults to "gemini-flash-latest".
GEMINI_MODEL="gemini-flash-latest"
